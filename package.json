{
  "name": "dental-centrum-dobes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jaw:prepare": "/Applications/Blender.app/Contents/MacOS/Blender --background assets/jaw-source/Teeth_Base_Mesh_Modeling.blend --python scripts/prepare-jaw-model.py",
    "jaw:optimize": "gltf-transform optimize public/media/jaw/jaw-desktop.raw.glb public/media/jaw/jaw-desktop.glb --compress meshopt --flatten false --join false --instance false --prune false && gltf-transform optimize public/media/jaw/jaw-mobile.raw.glb public/media/jaw/jaw-mobile.glb --compress meshopt --flatten false --join false --instance false --prune false",
    "jaw:validate": "node scripts/validate-jaw-model.mjs",
    "jaw:build": "npm run jaw:prepare && npm run jaw:optimize && npm run jaw:validate && node --input-type=module -e \"import { unlink } from 'node:fs/promises'; await Promise.all(['public/media/jaw/jaw-desktop.raw.glb', 'public/media/jaw/jaw-mobile.raw.glb'].map((path) => unlink(path)))\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@tabler/icons-react": "3.46.0",
    "motion": "13.0.0",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "meshoptimizer": "1.2.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.10"
  },
  "type": "module"
}
